# Deploy only what runs: server/, dist/ (vite build), cities/cities.json and each city's city.json and generated/, package files, app.yaml
# Patterns start with "/" so they match at the project root only: a bare `index.html` would also drop dist/index.html.
/.gcloudignore
.git
.gitignore
.env
.env.*
/.impeccable/
/skill-observations/
/reports/
/research_notes/
/.claude/
node_modules/
/src/
/scripts/
/public/
# cities/ is an allowlist: only cities.json and, per city, city.json and generated/ are uploaded. Everything else a city folder
# holds (raw, cache, seed, steps, tests, notes, other folders) stays out without being named here.
/cities/*
!/cities/cities.json
!/cities/*/
/cities/*/*
!/cities/*/city.json
!/cities/*/generated/
/cities.example/
/*.md
/tsconfig.json
/vite.config.ts
/index.html
/app.yaml.example
