# Copy to .env (gitignored). Nothing in here is ever baked into the client bundle;
# the browser gets public values from GET /api/config.

# --- Google Cloud / App Engine (only used by `npm run deploy` and `npm run gen:appyaml`)
GCP_PROJECT_ID=
GAE_SERVICE=default
# Region of the App Engine app and its Firestore database. Only used when the app is created: it cannot be changed afterwards.
GAE_REGION=europe-west3
GAE_RUNTIME=nodejs22
GAE_INSTANCE_CLASS=F1
GAE_MAX_INSTANCES=2

# --- Server
PORT=8080
# Contact for the User-Agent sent to Transitous / Nominatim / Photon (required by their usage policies)
CONTACT_EMAIL=

# --- External services (defaults shown)
BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
TRANSITOUS_URL=https://api.transitous.org
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Single routes (the line drawn from a spot to a commute place)
# auto: ask the city's own timetable service first when it has one and it is set up below, Transitous otherwise or when it fails
# transitous: never ask the local service. The commute map always comes from Transitous.
# ROUTE_SOURCE=auto
# ROUTE_COOLDOWN_MIN=10     # minutes a local service is left alone after a failure
# VBB (Berlin): request access from api@vbb.de; they send the key and the address of the server. Without both, routes come from Transitous.
# VBB_API_URL=
# VBB_ACCESS_ID=

# --- Rate limits (requests per minute per IP)
RATE_LIMIT_PER_MIN=120

# --- Shared rent prices (every visitor sees them). Default: a JSON file locally, Firestore on App Engine
# PRICE_STORE=file            # or firestore
# PRICE_FILE=cities/<id>/runtime/prices.json   # for the default city; the others use their own runtime/ folder
# PRICE_DATABASE=prices          # the default city's named Firestore database (Native mode), created by deploy:setup; else prices.database of its manifest
# PRICE_COLLECTION=rent_prices
# PRICE_WRITES_PER_MIN=20     # add/change/delete limit per IP

# --- Restaurant ratings (one-off, npm run data:ratings). Which service you ask is your choice: write a provider
# (scripts/data/ratings/template.mjs) and name it here: a bare name for scripts/data/ratings/<name>.mjs, pack/<name> for cities/ratings/<name>.mjs. Not needed to run the app; without it the restaurants metric is left out.
# RATINGS_PROVIDER=
# RATINGS_PACK_DIR=         # folder holding your own providers (pack/<name>), relative to the app; default cities/ratings
# RATINGS_MAX_REQUESTS=     # per month; overrides the provider's own limit
# Settings of the provider itself (a key, say) go here too, named as the provider reads them.
